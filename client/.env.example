# Copy this file to `.env`, `.env.production`, or `.env.development` and edit.
#
# All variables MUST be prefixed with VITE_ to be exposed to the client bundle.

# --- VITE_SOCKET_URL ----------------------------------------------------------
# The full URL of the realtime game server (Socket.io endpoint). Required when
# building the iOS app via Capacitor, because the bundled web app lives at
# `capacitor://localhost` and cannot infer the server from window.location.
#
# Examples:
#   Local development against your Mac's LAN IP (so the iPhone Simulator or
#   a real device on the same Wi-Fi can reach it):
#     VITE_SOCKET_URL=http://192.168.1.100:3000
#
#   Production (must be HTTPS for App Store distribution due to ATS):
#     VITE_SOCKET_URL=https://six-hand-bid-euchre-server.onrender.com
#
# Leave UNSET for the regular web dev workflow (`npm run dev` will use
# window.location.hostname:3000 as today).
VITE_SOCKET_URL=

# --- VITE_API_BASE_URL --------------------------------------------------------
# The base URL of the FastAPI auth/profile backend (login, create user, etc.).
# Wired into render.yaml for the deployed build; set it here for iOS builds.
#
#   VITE_API_BASE_URL=https://six-hand-bid-euchre-backend.onrender.com
VITE_API_BASE_URL=
